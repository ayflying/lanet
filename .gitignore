node_modules/
# 发布签名私钥等机密文件（严禁入库）
secrets/
# 节点运行时本地状态：身份私钥 / 地址簿 / 日志（由本地调试启动产生，严禁入库）
node.key
lanet.db
lanet.db-*
lanet.log
# C# 构建产物
sdk/csharp/**/bin/
sdk/csharp/**/obj/
*.user
# Android 移动端：AAR 由 sdk/go/mobile 现场编译产出（体积 20MB+，不入库），
# 构建方式见该目录包注释与 sdk/android/README.md
sdk/go/mobile/*.aar
sdk/go/mobile/*-src.jar
sdk/go/mobile/*-sources.jar
sdk/android/.gradle/
sdk/android/build/
sdk/android/app/build/
sdk/android/local.properties
sdk/android/app/libs/*.aar
sdk/android/dist/
sdk/android-plugin/**/build/
sdk/android-plugin/**/.gradle/
sdk/android-plugin/plugin/local.properties
# uni-app 插件交付包里的 aar 都是现场编译产物，合计 40MB+，不入库：
#   lanet.aar        ← sdk/go/mobile 用 gomobile 产出
#   lanet-plugin.aar ← sdk/android-plugin/plugin 编译产出
# 构建方式见 sdk/android-plugin/README.md
sdk/android-plugin/lanet-vpn/android/*.aar
# 从 lanet.aar 抽出的 classes.jar（library 模块不能直接依赖本地 aar，故抽出来编）
sdk/android-plugin/plugin/lanet-plugin/libs/*.jar
# uni-app 示例工程：插件包由 build.py 自动同步进来（39MB，不入库），
# unpackage/ 是 HBuilderX 的构建产物
sdk/uniapp-demo/nativeplugins/
sdk/uniapp-demo/unpackage/
